<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.ndg.common</groupId>
	<artifactId>ndgmap</artifactId>
	<version>0.8.0</version>
	<name>ndgMap</name>
	<description>Map coordinate spaces and rules for traversing between adjacent coordinates</description>

	<scm>
		<connection>scm:git:ssh://nigelgay@git.code.sf.net/p/momime/map</connection>
		<tag>ndgmap-0.8.0</tag>
	</scm>

	<parent>
		<groupId>com.ndg.common</groupId>
		<artifactId>parent</artifactId>
		<version>0.8.0</version>
	</parent>

	<build>
		<plugins>
			<plugin>
				<groupId>com.evolvedbinary.maven.jvnet</groupId>
				<artifactId>jaxb30-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>main-xjc-generate</id>
						<phase>generate-sources</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<schemaDirectory>src/main/resources/com.ndg.map</schemaDirectory>
							<generateDirectory>target/generated-sources/xjc-map</generateDirectory>
							<episodeFile>target/generated-sources/xjc-map/META-INF/map.episode</episodeFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>com.ndg.common</groupId>
			<artifactId>ndgutils</artifactId>
			<version>0.8.0</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
		</dependency>
	</dependencies>

</project>