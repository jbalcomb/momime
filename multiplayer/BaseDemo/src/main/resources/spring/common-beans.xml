<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd" >

	<bean id="clientToServerJaxbContext" class="jakarta.xml.bind.JAXBContext" factory-method="newInstance">
		<constructor-arg>
    		<list>
    			<value>com.ndg.multiplayer.base.ClientToServerMessage</value>
    			<value>com.ndg.multiplayer.basedemo.DateTimeRequest</value>
    			<value>com.ndg.multiplayer.basedemo.AddToTotal</value>
    			<value>com.ndg.multiplayer.basedemo.PauseRequest</value>
    			<value>com.ndg.multiplayer.basedemo.CounterRequest</value>
    		</list>
   		</constructor-arg>
	</bean>

	<bean id="serverToClientJaxbContext" class="jakarta.xml.bind.JAXBContext" factory-method="newInstance">
		<constructor-arg>
    		<list>
    			<value>com.ndg.multiplayer.base.ServerToClientMessage</value>
    			<value>com.ndg.multiplayer.basedemo.DateTimeResponse</value>
    			<value>com.ndg.multiplayer.basedemo.TotalSoFar</value>
    			<value>com.ndg.multiplayer.basedemo.PauseResponse</value>
    			<value>com.ndg.multiplayer.basedemo.CounterResponse</value>
    		</list>
   		</constructor-arg>
	</bean>

</beans>