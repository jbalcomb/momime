<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:mp="http://www.ndg.com/multiplayer/base"
	xmlns:mpd="http://www.ndg.com/multiplayer/basedemo" targetNamespace="http://www.ndg.com/multiplayer/basedemo">

    <xsd:import namespace="http://www.ndg.com/multiplayer/base"/>

	<!-- Ask server for time -->
    
	<xsd:element name="dateTimeRequest">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage" />
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="dateTimeResponse">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:serverToClientMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="dateTime" type="xsd:dateTime"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

	<!-- Add number to running total, to demonstrate persistent state -->
		
	<xsd:element name="addToTotal">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="value" type="xsd:int"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="totalSoFar">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:serverToClientMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="total" type="xsd:int"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	
	<!-- Example custom duration message, i.e. wait until a button is clicked -->
	
	<xsd:element name="pauseRequest">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage" />
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="pauseResponse">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:serverToClientMessage" />
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
		
	<!-- Example animation which ticks up and finishes by itself (or not, depending on pauseAfterwards setting) -->
		
	<xsd:element name="counterRequest">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="numberOfSeconds" type="xsd:int"/>
						<xsd:element minOccurs="1" maxOccurs="1" name="pauseAfterwards" type="xsd:boolean"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="counterResponse">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:serverToClientMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="numberOfSeconds" type="xsd:int"/>
						<xsd:element minOccurs="1" maxOccurs="1" name="pauseAfterwards" type="xsd:boolean"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>
