<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:mp="http://www.ndg.com/multiplayer/base"
	xmlns:mput="http://www.ndg.com/multiplayer/baseunittest" targetNamespace="http://www.ndg.com/multiplayer/baseunittest">

    <xsd:import namespace="http://www.ndg.com/multiplayer/base"/>

	<!-- Objects for simple streaming tests -->
    
	<xsd:element name="messageA">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="fieldA" type="xsd:normalizedString"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="messageB">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="fieldB" type="xsd:int"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

	<!-- Objects for client/server test -->
		
	<xsd:element name="request">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:clientToServerMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="count" type="xsd:int"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>	

	<xsd:element name="response">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="mp:serverToClientMessage">
					<xsd:sequence>
						<xsd:element minOccurs="1" maxOccurs="1" name="text" type="xsd:normalizedString"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
		
</xsd:schema>
